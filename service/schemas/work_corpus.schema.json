{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencray.local/service/schemas/work_corpus.schema.json",
  "title": "WorkCorpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "scenes"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "display_name"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "text"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "heading": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "perspective_character_id": {
            "type": "string"
          },
          "source_span": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "chapter_id": {
                "type": "string"
              },
              "start_offset": {
                "type": "integer",
                "minimum": 0
              },
              "end_offset": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencray.local/service/schemas/chat_corpus.schema.json",
  "title": "ChatCorpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "turns"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "display_name"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_id",
          "speaker",
          "text",
          "timestamp"
        ],
        "properties": {
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "speaker_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reply_to_turn_id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string"
          },
          "addressed_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quoted_speech": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

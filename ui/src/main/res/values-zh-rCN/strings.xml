    <string name="telemetry_toggle_disabled_summary">不会有遥测离开设备。</string>
    <string name="telemetry_toggle_disclosure">默认值：关闭。关闭遥测会阻止对外发送遥测，但本地设置、审批记录和最近的审计条目仍会保存在设备上。</string>
    <string name="privacy_guard_title">隐私保护</string>
    <string name="privacy_guard_enabled_summary">对符合条件的分析与审计细节启用本地脱敏。</string>
    <string name="privacy_guard_disabled_summary">对符合条件的分析与审计细节允许保留完整本地细节。</string>
    <string name="privacy_guard_disclosure">默认值：开启。隐私保护会影响后续遥测可包含的内容，但当前设置和最近审计历史仍会保留在本机。</string>
    <string name="telemetry_disclosure_title">默认值与本地保留</string>
    <string name="telemetry_state_current_label">当前</string>
    <string name="telemetry_state_default_label">默认</string>
    <string name="telemetry_state_on">开启</string>
    <string name="telemetry_state_off">关闭</string>
    <string name="safety_limits_title">安全与限制</string>
    <string name="safety_limits_subtitle">这里集中展示风险边界和发布级提示，方便快速查看。</string>
    <string name="mode_risks_heading">模式风险</string>
    <string name="mode_risks_intro">三种模式的风险差异集中放在这里，切换前可以快速对比。</string>
    <string name="rollback_limits_heading">回滚限制</string>
    <string name="rollback_limits_intro">这里只说明已经验证过的本地回滚范围，不夸大恢复能力。</string>
    <string name="telemetry_privacy_heading">遥测与隐私</string>
    <string name="telemetry_privacy_intro">这里汇总和设置页一致的默认值与保留说明。</string>
    <string name="telemetry_privacy_footer">默认值：开启遥测 = 关闭。开启隐私保护 = 开启。</string>
    <string name="v1_scope_heading">V1 范围</string>
    <string name="v1_scope_intro">这里明确 V1 边界，避免把未来计划误认为已交付能力。</string>
    <string name="mode_risk_safe_label">Safe</string>
    <string name="mode_risk_safe_title">默认先审查</string>
    <string name="mode_risk_safe_body">Safe 模式会在敏感操作前显式停下来请求审批，因此 OpenCray 会优先保证审查，而不是速度。</string>
    <string name="mode_risk_safe_note">如果你想要最低风险的默认路径，就用这个模式。</string>
    <string name="mode_risk_auto_label">Auto</string>
    <string name="mode_risk_auto_title">更少打断意味着更高风险</string>
    <string name="mode_risk_auto_body">Auto 模式会减少打断，并让更多已允许的流程自动继续，因此一旦出错，影响可能会在更晚才被发现。</string>
    <string name="mode_risk_auto_note">Auto 可以减少提示，但硬性拒绝仍会阻止受保护或越界路径操作。</string>
    <string name="mode_risk_developer_label">Developer</string>
    <string name="mode_risk_developer_title">最高风险的本地控制面</string>
    <string name="mode_risk_developer_body">Developer 模式会暴露高风险操作，并为调试或高级使用减少提示。</string>
    <string name="mode_risk_developer_note">Developer 模式不会覆盖硬性拒绝。受保护文件、路径和其他硬性策略拒绝仍会阻止操作。</string>
    <string name="rollback_local_only_label">仅限本地</string>
    <string name="rollback_local_only_title">只保证本地文件系统检查点</string>
    <string name="rollback_local_only_body">回滚只保证 OpenCray 在这台设备上创建的本地文件系统检查点。</string>
    <string name="rollback_local_only_note">把回滚当成本地安全网，不要把它理解成通用撤销系统。</string>
    <string name="rollback_not_covered_label">不覆盖</string>
    <string name="rollback_not_covered_title">远端和外部影响不保证可回滚</string>
    <string name="rollback_not_covered_body">回滚仅限本地，不保证 shell 命令、MCP 操作、网络请求、云端变更或任何其他外部系统变化能够恢复。</string>
    <string name="rollback_not_covered_note">如果影响已经离开设备或触及其他系统，回滚可能无法撤销。</string>
    <string name="privacy_enable_telemetry_label">开启遥测</string>
    <string name="privacy_enable_telemetry_title">默认：关闭</string>
    <string name="privacy_enable_telemetry_body">开启后允许匿名产品遥测离开设备；关闭则阻止对外发送遥测。</string>
    <string name="privacy_enable_telemetry_note">这个设置会保存在本机，后续可在 TelemetryToggles 或 设置 &gt; 遥测与隐私 中修改。</string>
    <string name="privacy_guard_label">隐私保护</string>
    <string name="privacy_guard_title_card">默认：开启</string>
    <string name="privacy_guard_body">隐私保护会对符合条件的分析和审计细节启用本地脱敏，即使遥测保持关闭也是如此。</string>
    <string name="privacy_guard_note_card">这个设置会保存在本机，后续可在 TelemetryToggles 或 设置 &gt; 遥测与隐私 中修改。</string>
    <string name="v1_scope_termux_label">Termux</string>
    <string name="v1_scope_termux_title">V1 不提供真正的 Termux 执行。</string>
    <string name="v1_scope_termux_body">当前 V1 运行时仍然只支持应用内执行，Termux 只是被记录为后续阶段，而不是已交付执行路径。</string>
    <string name="v1_scope_termux_note">不要在这个版本里把真实 Termux 执行描述成可用功能。</string>
    <string name="v1_scope_future_label">超出范围</string>
    <string name="v1_scope_future_title">并行多 agent、iOS、云同步、公开市场都不属于 V1。</string>
    <string name="v1_scope_future_body">多 agent 并行执行、iOS 客户端支持、云协作同步，以及公开市场/评审系统都不在 V1 范围内。</string>
    <string name="v1_scope_future_note">这些能力以后可以规划，但现在不能被暗示为已交付。</string>
</resources>

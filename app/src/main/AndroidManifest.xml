<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:label="@string/app_name">
        <activity
            android:name="com.opencray.app.AppShellActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.opencray.app.SkillsManagementActivity"
            android:exported="true"
            android:label="@string/activity_label_skills_management"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="com.opencray.app.MainInteractionActivity"
            android:exported="true"
            android:label="@string/activity_label_main_interaction"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="com.opencray.app.WorkspaceSettingsActivity"
            android:exported="true"
            android:label="@string/activity_label_workspace_settings"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="com.opencray.app.SafetyAndLimitsActivity"
            android:exported="true"
            android:label="@string/activity_label_safety_limits"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/opencray_file_provider_paths" />
        </provider>
    </application>
</manifest>
